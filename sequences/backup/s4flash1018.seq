search tests
search utilities

exec setup_variables.py                                     # Setup Variables
exec record_serial_number.py                                # Record SN
exec mlu370_check_boot_status.py --empty                    # Check M0 Boot Status

opstart flashmcu
  repeat 200
    exec mlu370_update_mcu.py --force                       # Update MCU
    exec pcie_link_down.py                                  # PCIE Linkdown
    exec pcie_link_check.py --gen1                          # PCIE Link Status Check
    exec mlu370_update_mcu.py --force                       # Update MCU Bak App
    exec pcie_link_down.py                                  # PCIE Linkdown
    exec pcie_link_check.py --gen1                          # PCIE Link Status Check
    exec mlu370_check_boot_status.py --empty                # Check M0 Boot Status
    exec mlu370_check_fw_version.py                         # Check MCU Version
    exec reboot.py                                          # Reboot
  end
opstop

